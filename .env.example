# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nyc_311
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=your_password_here

# NYC Open Data API (no auth required, but optionally add an app token for higher rate limits)
NYC_API_BASE_URL=https://data.cityofnewyork.us/resource/erm2-nwe9.json
NYC_API_APP_TOKEN=

# Pipeline settings
BATCH_SIZE=1000
MAX_PAGES=10
LOG_LEVEL=INFO
